# ==============================================================================
# NuKlean Mobile App - Environment Configuration Template
# Copy this file to '.env' and fill in your actual values.
# ==============================================================================

# Backend API Endpoint URL
BASE_URL=https://your-backend-api-production-url.railway.app

# Cloudinary Upload Credentials (Unsigned presets are client-safe)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_UPLOAD_PRESET=your_cloudinary_upload_preset

# Google Maps Geocoding & Places API Key (Optional: for 100% Google Maps address matching)
GOOGLE_MAPS_API_KEY=your_google_maps_geocoding_api_key

